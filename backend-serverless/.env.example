## ─── MSW Platform — Serverless Backend ───────────────────────────────────────
## Copy this file to .env and fill in the values.
## deploy.sh will read from this file if present, or generate values automatically.

# JWT secret for signing tokens (deploy.sh generates one if not set)
JWT_SECRET=your-secret-key-change-this

# AWS region for all resources
AWS_REGION=ap-southeast-1

# S3 bucket for report attachments (deploy.sh sets this to msw-attachments-<ACCOUNT_ID>)
MSW_ATTACHMENTS_BUCKET=msw-attachments-ACCOUNTID

# SES verified sender address (emails won't send until verified in SES)
MAIL_FROM_ADDRESS=noreply@yourdomain.com

# CloudFront domain for serving attachment URLs (set after first deploy)
CLOUDFRONT_DOMAIN=

# Prefix for all DynamoDB table names
TABLE_PREFIX=msw

# S3 bucket for static web hosting (Expo web build)
MSW_WEB_BUCKET=msw-web-ACCOUNTID
